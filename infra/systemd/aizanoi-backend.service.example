[Unit]
Description=Aizanoi Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/example-backend
ExecStart=/usr/bin/node /opt/example-backend/server.js
Restart=on-failure
RestartSec=5
User=example
Group=example
Environment=NODE_ENV=production
Environment=SANDBOX_DIR=/var/lib/aizanoi/sandbox

# Create /var/lib/aizanoi owned by the service user.
StateDirectory=aizanoi
StateDirectoryMode=0700
UMask=0077

# systemd sandbox baseline. The service only needs its application files
# read-only plus /var/lib/aizanoi for the fake terminal sandbox.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/aizanoi

[Install]
WantedBy=multi-user.target
