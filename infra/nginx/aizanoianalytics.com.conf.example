server {
    server_name example.com;
    root /var/www/example.com;
    index index.html;

    # Common non-secret security baseline. TLS/HSTS belongs in the production
    # HTTPS server block and is intentionally not fabricated in this example.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # The legacy shell still contains inline CSS/JS. Keep this transitional CSP
    # until inline code is mechanically extracted; do not weaken other sources.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; worker-src 'self' blob:" always;

    # The Node API never accepts a body larger than this. Reject oversized
    # requests before proxying them to the application.
    client_max_body_size 128k;

    error_page 404 /404.html;
    error_page 500 /500.html;
    error_page 502 503 504 /503.html;
    location = /404.html { internal; }
    location = /500.html { internal; }
    location = /503.html { internal; }

    # Product decisions / legacy URLs.
    location = /ai { return 410; }
    location = /ai/ { return 410; }
    location = /market { return 410; }
    location ^~ /market/ { return 410; }

    # External AI integration is intentionally removed. Block the historical
    # endpoint at the reverse proxy as well as in Node (defense in depth).
    location = /api/chat {
        return 410;
    }

    # Health endpoint is read-only and proxied explicitly.
    location = /api/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3001/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store" always;
    }

    # Fake terminal endpoint. The Node backend only dispatches a fixed command
    # whitelist and binds to loopback; arbitrary shell execution is forbidden.
    location = /api/terminal/exec {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3001/api/terminal/exec;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    # Never proxy unknown API paths.
    location ^~ /api/ {
        return 404;
    }

    # Standalone Historic World (Roman Aizanoi).
    location = /historic-world {
        return 301 /historic-world/;
    }

    location = /historic-world/ {
        try_files /historic-world/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ^~ /historic-world/ {
        try_files $uri =404;
    }

    # Standalone modular Ancient World cities.
    location = /ancient-cities/rome-410-476 {
        return 301 /ancient-cities/rome-410-476/;
    }
    location ^~ /ancient-cities/rome-410-476/ {
        try_files $uri $uri/ =404;
    }

    location = /ancient-cities/athens-450-430 {
        return 301 /ancient-cities/athens-450-430/;
    }
    location ^~ /ancient-cities/athens-450-430/ {
        try_files $uri $uri/ =404;
    }

    # Service workers should revalidate so security fixes propagate promptly.
    location = /service-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Static asset caching. File names under these directories are treated as
    # deploy-versioned assets; update cache strategy if that convention changes.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /icons/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Known virtual Aizanoi OS routes. They intentionally receive the SPA shell.
    location ~ ^/(hr-analytics|ancient-world|games|projects|videos|about|docs|changelog|privacy|terms)/?$ {
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # Real files/directories work normally. Unknown paths return a true 404.
    location / {
        try_files $uri $uri/ =404;
    }
}
