server {
    server_name example.com;
    root /var/www/example.com;
    index index.html;

    # Common non-secret security baseline. TLS/HSTS belongs in the production
    # HTTPS server block and is intentionally not fabricated in this example.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # Field System v3 no longer needs inline JavaScript. Historical-world source
    # still contains a small amount of inline presentation metadata, so style-src
    # keeps unsafe-inline until that city-local markup is extracted separately.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; worker-src 'self' blob:" always;

    client_max_body_size 128k;

    # Low-cost static compression. Brotli can be enabled too when the production
    # Nginx build includes the module; gzip is available in standard packages.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 768;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Keep the PWA manifest's MIME explicit even on minimal mime.types installs.
    types { application/manifest+json webmanifest; }

    error_page 404 /404.html;
    error_page 500 /500.html;
    error_page 502 503 504 /503.html;
    location = /404.html { internal; }
    location = /500.html { internal; }
    location = /503.html { internal; }

    # Product decisions / retired public URLs.
    location = /ai { return 410; }
    location = /ai/ { return 410; }
    location = /market { return 410; }
    location ^~ /market/ { return 410; }

    # Historical clients receive an explicit retirement response only on the old
    # chat endpoint. Aizanoi's public web runtime has no application API.
    location = /api/chat {
        return 410;
    }
    location ^~ /api/ {
        return 404;
    }

    location = /.well-known/security.txt {
        try_files $uri =404;
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # The root shell and service worker revalidate so product/security fixes are
    # visible quickly. App modules/styles are intentionally lazy but not yet
    # content-hashed, so they use a bounded cache rather than false immutability.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location = /service-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location ^~ /styles/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location ^~ /js/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800" always;
    }
    location ^~ /games/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # Standalone Historic World (Roman Aizanoi).
    location = /historic-world {
        return 301 /historic-world/;
    }
    location = /historic-world/ {
        try_files /historic-world/index.html =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location ^~ /historic-world/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # Standalone modular Ancient World cities.
    location = /ancient-cities/rome-410-476 {
        return 301 /ancient-cities/rome-410-476/;
    }
    location ^~ /ancient-cities/rome-410-476/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location = /ancient-cities/athens-450-430 {
        return 301 /ancient-cities/athens-450-430/;
    }
    location ^~ /ancient-cities/athens-450-430/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # Current app state lives in ?app=<id>; these legacy convenience routes may
    # still open the shell for old bookmarks, but no retired AI route is served.
    location ~ ^/(ancient-world|games|projects|videos|about|docs|changelog|privacy|terms)/?$ {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Real files/directories work normally. Unknown paths return a true 404.
    location / {
        try_files $uri $uri/ =404;
    }
}
